      "description": "For growing teams with production workloads",
      "sort_order": 2,
      "billing_model": "subscription_with_credits",
      "price": {"amount_per_period": 99.00, "currency": "USD", "period": "month"},
      "credit_grant": {
        "trigger": "subscription_invoice_paid",
        "amount_per_period": 99.00,
        "currency": "USD",
        "lifecycle": "use_it_or_lose_it",
        "destination": "subscription_credit",
        "reset_on_downgrade": true,
        "reset_on_upgrade": false
      },
      "features": ["basic_sandboxes", "browser_sessions", "desktop_sessions", "api_access", "gpu_access", "audit_logs", "priority_support"],
      "upgrade_url": "/billing?upgrade=1",
      "limits": {
        "sandbox.concurrent": 25,
        "sandbox.monthly_cost": 1000.00,
        "sandbox.gpu_instances": 5,
        "sandbox.browser_sessions": 50,
        "sandbox.desktop_sessions": 25,
        "sandbox.home_storage_gb": 600
      }
    },
    {
      "tier_id": "enterprise",
      "display_name": "Enterprise",
      "description": "Custom limits, SLA, dedicated support",
      "sort_order": 3,
      "billing_model": "subscription_with_credits",
      "price": {"amount_per_period": 499.00, "currency": "USD", "period": "month"},
      "credit_grant": {
        "trigger": "subscription_invoice_paid",
        "amount_per_period": 499.00,
        "currency": "USD",
